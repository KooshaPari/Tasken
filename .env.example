# Example environment configuration for taskkit.
# Copy this file to `.env` and set only non-secret values.

# Application runtime
TASKEN_DATA_DIR=./.taskkit
TASKEN_STORE_FILE=store.json
TASKEN_CACHE_DIR=./.taskkit/cache
TASKEN_CACHE_FILE=cache.json
TASKEN_CACHE_TTL_SECONDS=300
TASKEN_DEFAULT_LIST_LIMIT=100

# Observability
TASKEN_LOG_FORMAT=json
# Leave unset to inherit the default "info" filter, or set a narrower scope.
# Examples: `taskkit=debug`, `info,taskkit::application=trace`
RUST_LOG=taskkit=info

# Deployment/runtime knobs
# TASKEN_LOG_LEVEL=info
# TASKEN_SHUTDOWN_TIMEOUT_SECONDS=30
